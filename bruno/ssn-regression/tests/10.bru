meta {
  name: Test 10 (expects 303)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/x/y
  body: none
  auth: none
}

headers {
  Accept: text/html,*/*;q=0.8
}

assert {
  res.status: eq 303
  res.headers.location: eq "https://www.w3.org/TR/vocab-ssn/#SSNx/y"
}

settings {
  encodeUrl: false
  followRedirects: false
  maxRedirects: 5
  timeout: inherit
}
