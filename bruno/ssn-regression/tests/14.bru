meta {
  name: Test 14 (expects 303)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/ssn
  body: none
  auth: none
}

headers {
  Accept: text/html
}

assert {
  res.status: eq 303
  res.headers.location: eq "https://www.w3.org/TR/vocab-ssn/"
}

settings {
  encodeUrl: false
  followRedirects: false
  maxRedirects: 5
  timeout: inherit
}
