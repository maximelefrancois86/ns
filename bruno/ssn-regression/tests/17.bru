meta {
  name: Test 17 (expects 406)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/dul
  body: none
  auth: none
}

headers {
  Accept: text/html
}

assert {
  res.status: eq 406
  res.headers.content-type: eq "text/html; charset=iso-8859-1"
}

settings {
  encodeUrl: false
  followRedirects: false
  maxRedirects: 5
  timeout: inherit
}
