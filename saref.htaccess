RewriteRule ^sources/(.*)$ https://labs.etsi.org/rep/saref/$1 [R=302]

Header set Content-disposition "expr=attachement; filename=%{resp:Content-Location}" "expr=%{resp:Content-Location} =~ /.(rdf|nt|n3)$/"
Header set Content-disposition "expr=inline; filename=%{resp:Content-Location}" "expr=%{resp:Content-Location} =~ /.+/ && !( %{resp:Content-Location} =~ /.(rdf|nt|n3)$/ )"

RewriteCond %{REQUEST_URI} ^(.*/)?[^/]*$
RewriteRule ^core/$ %1v4.1.1/ [R=302]
RewriteCond %{REQUEST_URI} ^(.*/)?[^/]*$
RewriteRule ^core\.([^\./]+)$ %1core/v4.1.1/saref.$1 [R=302]

RewriteCond %{REQUEST_URI} ^(.*/)?[^/]*$
RewriteRule ^core/v3$ %1v3.2.1/ [R=302]
RewriteCond %{REQUEST_URI} ^(.*/)?[^/]*$
RewriteRule ^core/v3\.([a-z][^\./]*)$ %1v3.2.1/saref.$1 [R=302]

