  <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/dolce">
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
    <owl:imports rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic"/>
    <dcterms:created>2026-06-02</dcterms:created>
    <dcterms:creator>Alessandro Mosca</dcterms:creator>
    <dcterms:creator>Claudio Masolo</dcterms:creator>
