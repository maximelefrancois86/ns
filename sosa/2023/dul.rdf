    <rdfs:comment xml:lang="en">Alignment of the the W3C/OGC SOSA Ontology with the DOLCE UltraLite upper ontology (DUL).</rdfs:comment>
    <rdfs:label xml:lang="en">Alignment of SOSA with DUL</rdfs:label>
    <owl:imports rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
  </owl:Ontology>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/SampleCollection">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n648622a9226b4aa48a02dc63b298019ab22">
        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart"/>
        <owl:allValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ExecutionCollection">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Collection"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n648622a9226b4aa48a02dc63b298019ab9">
        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart"/>
        <owl:allValuesFrom>
          <owl:Class rdf:nodeID="n648622a9226b4aa48a02dc63b298019ab10">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event"/>
              <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Situation"/>
            </owl:unionOf>
          </owl:Class>
        </owl:allValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample">
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
