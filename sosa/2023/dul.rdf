  xmlns:foaf="http://xmlns.com/foaf/0.1/"
>
  <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/dul">
    <dcterms:creator>Maxime Lefrançois</dcterms:creator>
    <dcterms:creator>
      <foaf:Agent rdf:nodeID="n648622a9226b4aa48a02dc63b298019ab1">
