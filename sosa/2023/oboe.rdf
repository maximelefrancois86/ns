<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
  <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/oboe">
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-03-05</dcterms:created>
    <dcterms:creator rdf:resource="http://orcid.org/0000-0002-3884-3420"/>
    <dcterms:creator>Simon J D COX</dcterms:creator>
    <dcterms:creator>
      <foaf:Agent rdf:nodeID="nd53943a15ce74884879409b3db4bd09db7">
        <foaf:name xml:lang="en">W3C/OGC Spatial Data on the Web Working Group</foaf:name>
      </foaf:Agent>
    </dcterms:creator>
    <dcterms:description>Mapping of classes and properties from OBOE to SOSA</dcterms:description>
    <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
    <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-31</dcterms:modified>
    <dcterms:rights>Copyright 2025 W3C/OGC.</dcterms:rights>
    <rdfs:label>OBOE -&gt; SOSA map</rdfs:label>
    <owl:imports rdf:resource="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Measurement">
    <rdfs:comment>
  an oboe-core:Measurement is a (atomic) sosa:Observation, whose result (value) is an estimate of the value of one of the characteristics of the observed Entity. 
  A collection of oboe-core:Measurement individuals together compose an oboe-core:Observation, whose results together provide a full description of the feature of interest. 
  </rdfs:comment>
    <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#ObservationCollection">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nd53943a15ce74884879409b3db4bd09db3">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasMember"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Protocol">
    <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/ObservingProcedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
    <rdfs:subClassOf rdf:resource="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Observation">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nd53943a15ce74884879409b3db4bd09db1">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasMember"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nd53943a15ce74884879409b3db4bd09db2">
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
        <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#ofCharacteristic">
    <owl:equivalentProperty rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Result">
    <rdfs:subClassOf rdf:resource="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#usesMethod">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#hasValue">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasResult"/>
  </rdf:Description>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Characteristic">
    <owl:equivalentClass rdf:resource="http://www.w3.org/ns/sosa/Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#hasMeasurement">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasMember"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#hasMember">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/hasMember"/>
  </rdf:Description>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#usesProtocol">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
  </rdf:Description>
  <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#measurementFor"/>
      <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#ofEntity"/>
    </owl:propertyChainAxiom>
  </rdf:Description>
  <rdf:Description rdf:about="http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#measurementFor">
    <rdfs:subPropertyOf>
      <rdf:Description rdf:nodeID="nd53943a15ce74884879409b3db4bd09db4">
        <owl:inverseOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
      </rdf:Description>
    </rdfs:subPropertyOf>
  </rdf:Description>
</rdf:RDF>
