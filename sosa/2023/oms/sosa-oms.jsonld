    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/SamplingProcedure",
    "http://www.opengis.net/def/ont/modspec/implements": [
      {
        "@id": "http://www.opengis.net/spec/om/3.0/req/sam-cpt/SamplingProcedure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/sam/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "[ISO 19156:2023] A SamplingProcedure shall be defined as the description of steps performed by a Sampler in order to extract a Sample from its sampledFeature in the frame of a Sampling."
      }
    ]
  },
