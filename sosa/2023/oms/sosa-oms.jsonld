  },
  {
    "@id": "http://www.w3.org/ns/sosa/ObservingProcedure",
    "http://www.opengis.net/def/ont/modspec/implements": [
      {
        "@id": "http://www.opengis.net/spec/om/3.0/req/obs-cpt/ObservingProcedure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/obs/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "[ISO 19156:2023] An ObservingProcedure shall be defined as the description of steps performed in order to determine the value of an observableProperty by an Observer."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "[ISO 19156:2023] An instance of Procedure is a description of the process used by an observer. This could be a chemical analysis method, a protocol for measuring an object, or even a checklist used by a human observer during a biodiversity campaign. Procedure could further describe the algorithms behind simulators or models used to generate a result from other inputs."
      }
    ]
  },
