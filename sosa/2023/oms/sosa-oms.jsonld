  {
    "@id": "http://www.w3.org/ns/sosa/oms/PreparationProcedure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.opengis.net/def/ont/modspec/implements": [
      {
        "@id": "http://www.opengis.net/spec/om/3.0/req/sam-cpt/PreparationProcedure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/oms/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Preparation Procedure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Procedure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "[ISO 19156:2023] A PreparationProcedure shall be defined as the description of preparation steps performed on a Sample"
      },
      {
        "@language": "en",
        "@value": "\n  A workflow, protocol, plan, algorithm, or computational method specifying a step in preparing a Sample. \n  A Preparation Procedure is re-usable, and might be involved in many preparations. \n  It explains the steps to be carried out to arrive at reproducible results.\n  "
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Sensor",
