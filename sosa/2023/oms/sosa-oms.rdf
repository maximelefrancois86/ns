        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling/samplingProcedure-sem"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
