  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/observedProperty">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/observedProperty-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/observer-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/horizontalPositionalAccuracy">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/SpatialSample/horizontalPositionalAccuracy-sem"/>
    <rdfs:label xml:lang="en">horizontal positional accuracy</rdfs:label>
    <skos:definition xml:lang="en">positional accuracy of the horizontal component of the Geometry of the SpatialSample.</skos:definition>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/SpatialSample"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasResult">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/result-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling/sample-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/implementedBy">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/ObservingProcedure/observer-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/SamplingProcedure/sampler-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/PreparationStep/processingDetails-sem"/>
    <owl:inverseOf>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/implements">
