<rdf:RDF
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:schema1="http://schema.org/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:ogc-ms="http://www.opengis.net/def/ont/modspec/"
>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/metadata">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-core/gen/metadata-sem"/>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Property">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/ObservableProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Observation">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservationCollection">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-basic/ObservationCollection"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sample">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sample"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/SampleCollection">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/SampleCollection"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sampling">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/SamplingCollection"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/oms/PreparationStep"/>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Procedure">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Procedure"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ActuatingProcedure"/>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservingProcedure">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/ObservingProcedure"/>
        <skos:definition>[ISO 19156:2023] An ObservingProcedure shall be defined as the description of steps performed in order to determine the value of an observableProperty by an Observer.</skos:definition>
        <skos:example xml:lang="en">[ISO 19156:2023] An instance of Procedure is a description of the process used by an observer. This could be a chemical analysis method, a protocol for measuring an object, or even a checklist used by a human observer during a biodiversity campaign. Procedure could further describe the algorithms behind simulators or models used to generate a result from other inputs.</skos:example>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/SamplingProcedure">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/SamplingProcedure"/>
        <skos:definition>[ISO 19156:2023] A SamplingProcedure shall be defined as the description of steps performed by a Sampler in order to extract a Sample from its sampledFeature in the frame of a Sampling.</skos:definition>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/oms/PreparationProcedure"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observer"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sampler">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampler"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Platform">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Host"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Deployment">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Deployment"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/oms/">
        <dcterms:title xml:lang="en">OMS Ontology - based on (SOSA) Ontology</dcterms:title>
        <dcterms:description xml:lang="en">This ontology is based on the SOSA Ontology by the W3C/OGC Spatial Data on the Web Working Group, supplemented by some classes and properties required to implement ISO 19156:2023 .</dcterms:description>
        <dcterms:creator>
          <foaf:Agent rdf:nodeID="n9665591773af49efa112533b93cf94cfb1">
            <foaf:name xml:lang="en">W3C/OGC Spatial Data on the Web Working Group</foaf:name>
          </foaf:Agent>
        </dcterms:creator>
        <dcterms:rights>Copyright 2025 W3C/OGC.</dcterms:rights>
        <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
        <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-07</dcterms:created>
        <dcterms:source rdf:resource="https://docs.ogc.org/as/20-082r4/20-082r4.html"/>
        <rdfs:comment>The original source of each resource is indicated by the rdfs:isDefinedBy property</rdfs:comment>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/time">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-core/AbstractSampling/time-sem"/>
    <rdfs:label xml:lang="en">sampling time</rdfs:label>
    <skos:definition xml:lang="en">If information on the time of the Sampling is provided, the attribute time:TM_Object shall be used.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/relatedSampling">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling/relatedSampling-sem"/>
    <rdfs:label xml:lang="en">related sampling</rdfs:label>
    <skos:definition xml:lang="en">Relation to an act of Sampling.</skos:definition>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/usedProcedure">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/observingProcedure-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling/samplingProcedure-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/validTime">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/validTime-sem"/>
    <rdfs:label xml:lang="en">valid time</rdfs:label>
    <skos:definition xml:lang="en">The time interval during which the result is assumed to be applicable for use.</skos:definition>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/SamplingCollection"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/2006/time#Interval"/>
    <schema1:rangeIncludes rdf:resource="http://purl.org/dc/terms/PeriodOfTime"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/verticalPositionalAccuracy">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/SpatialSample/verticalPositionalAccuracy-sem"/>
    <rdfs:label xml:lang="en">vertical positional accuracy</rdfs:label>
    <skos:definition xml:lang="en">positional accuracy of the vertical component of the Geometry of the SpatialSample.</skos:definition>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/SpatialSample">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/SpatialSample"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/parameter">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-core/AbstractSampling/parameter-sem"/>
    <rdfs:label xml:lang="en">parameter</rdfs:label>
    <skos:definition xml:lang="en">Arbitrary event-specific parameter relevant to the Sampling.</skos:definition>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/featureOfInterest-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-core/AbstractObservationCharacteristics/pFoI-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling/featureOfInterest-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isSampleOfUltimateFOI">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sample/sampledFeature-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/size">
    <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/quantity"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/MaterialSample/size-sem"/>
    <rdfs:label xml:lang="en">size</rdfs:label>
    <skos:definition xml:lang="en">a physical extent of the MaterialSample.</skos:definition>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/MaterialSample">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/MaterialSample"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/shape">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/SpatialSample/shape-sem"/>
    <rdfs:label xml:lang="en">shape</rdfs:label>
    <skos:definition xml:lang="en">the Geometry of the SpatialSample.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/SpatialSample"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/usedForExecution">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/gen/relatedObservation-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySampler">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-cpt/Sampling/sampler-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isFeatureOfInterestOf">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/gen/relatedObservation-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/deployedSystem">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Deployment/observer-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/samplingLocation">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-core/AbstractSampling/samplingLocation-sem"/>
    <rdfs:label xml:lang="en">sampling location</rdfs:label>
    <skos:definition xml:lang="en">If location information pertaining to the Sampling is provided, the attribute samplingLocation:Geometry shall be used.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isResultOf">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/gen/relatedObservation-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/classification">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/StatisticalSample/classification-sem"/>
    <rdfs:label xml:lang="en">classification</rdfs:label>
    <skos:definition xml:lang="en">a criterion by which the subset was defined.</skos:definition>
    <schema1:domainIncludes>
      <rdf:Description rdf:about="http://www.w3.org/ns/sosa/StatisticalSample">
        <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/StatisticalSample"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
      </rdf:Description>
    </schema1:domainIncludes>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/observationType">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-core/AbstractObservationCharacteristics/type-sem"/>
    <rdfs:label xml:lang="en">observation type</rdfs:label>
    <skos:definition xml:lang="en">Information providing further detail on the type of Observations.</skos:definition>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/resultQuality">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-core/AbstractObservationCharacteristics/resultQuality-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/phenomenonTime">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observation/phenomenonTime-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/sourceLocation">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/MaterialSample/sourceLocation-sem"/>
    <rdfs:label xml:lang="en">source location</rdfs:label>
    <skos:definition xml:lang="en">the location from where the MaterialSample was obtained.</skos:definition>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/MaterialSample"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/observes">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-cpt/Observer/observableProperty-sem"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
  </rdf:Description>
  <owl:ObjectProperty rdf:about="http://www.opengis.net/def/ont/modspec/implementedBy">
    <skos:definition>link from a requirement linked to an element in a UML model to an RDFS/OWL class or property which implements it</skos:definition>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.opengis.net/def/ont/modspec/implements">
        <skos:definition>link from an RDFS/OWL class or property to a requirement linked to an element in a UML model which it implements</skos:definition>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/source"/>
        <rdfs:subPropertyOf rdf:resource="https://www.w3.org/TR/prov-o/#wasDerivedFrom"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/oms/storageLocation">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/MaterialSample/storageLocation-sem"/>
    <rdfs:label xml:lang="en">storage location</rdfs:label>
    <skos:definition xml:lang="en">the location of a MaterialSample.</skos:definition>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/MaterialSample"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/oms/"/>
  </owl:ObjectProperty>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasMember">
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/sam-basic/SampleCollection/member-sem"/>
    <ogc-ms:implements rdf:resource="http://www.opengis.net/spec/om/3.0/req/obs-basic/ObservationCollection/member-sem"/>
