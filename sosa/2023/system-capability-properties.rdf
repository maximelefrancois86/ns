<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:voaf="http://purl.org/vocommons/voaf#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:sosa="http://www.w3.org/ns/sosa/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#RFSensitivity">
    <rdfs:label xml:lang="en">RF sensitivity</rdfs:label>
    <skos:definition xml:lang="en">The minimum radio frequency signal power that the system can detect or decode reliably.</skos:definition>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <dcterms:title xml:lang="en">Sample vocabulary of properties about system capabilities</dcterms:title>
        <dcterms:description xml:lang="en">This vocabulary defines a short list of properties about system capabilities. 

  It is only for illustration purposes, as the Spatio-temporal Data on the Web Working Group does not ambition to maintain a living list of properties. Extensions of this list should be led by other organization, and publications done to relevant vocabulary portals.</dcterms:description>
        <dcterms:creator>
          <foaf:Agent rdf:nodeID="n305bb0d685c140fea38b4cf9aa03b0cfb1">
            <foaf:name xml:lang="en">W3C/OGC Spatio-temporal Data on the Web Working Group</foaf:name>
          </foaf:Agent>
        </dcterms:creator>
        <dcterms:rights>Copyright 2025 W3C/OGC.</dcterms:rights>
        <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
        <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
        <rdfs:comment xml:lang="en">Please report any errors to the W3C Spatio-temporal Data on the Web Working Group via the SDW WG Public List public-sdw-wg@w3.org</rdfs:comment>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-05</dcterms:modified>
        <vann:preferredNamespacePrefix>sosa-cap</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.w3.org/ns/sosa/system-capability-properties#</vann:preferredNamespaceUri>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/systems/"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MaxMeasurableHumidity">
    <rdfs:label xml:lang="en">maximum measurable humidity</rdfs:label>
    <skos:definition xml:lang="en">The maximum relative humidity value that the system can measure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Frequency">
    <rdfs:label xml:lang="en">frequency</rdfs:label>
    <skos:definition xml:lang="en">The rate at which a system performs a function, such as sensing or actuation.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#TemperatureAccuracy">
    <rdfs:label xml:lang="en">temperature accuracy</rdfs:label>
    <skos:definition xml:lang="en">The closeness of agreement between the measured temperature and the true temperature.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#LowerDetectionLimit">
    <rdfs:label xml:lang="en">lower detection limit</rdfs:label>
    <skos:definition xml:lang="en">The smallest quantity of a substance that can be reliably detected by the sensor.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MinFrequency">
    <rdfs:label xml:lang="en">minimum frequency</rdfs:label>
    <skos:definition xml:lang="en">The lowest frequency at which the system can operate or make observations.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Sensitivity">
    <rdfs:label xml:lang="en">sensitivity</rdfs:label>
    <skos:definition xml:lang="en">The magnitude of change in output of a sensor per unit change in input.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Accuracy">
    <rdfs:label xml:lang="en">accuracy</rdfs:label>
    <skos:definition xml:lang="en">Closeness of agreement between a measured value and the true value.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Drift">
    <rdfs:label xml:lang="en">drift</rdfs:label>
    <skos:definition xml:lang="en">The slow change in a sensor's output signal without a corresponding change in the input.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#BatteryLifetime">
    <rdfs:label xml:lang="en">Battery Lifetime</rdfs:label>
    <skos:definition xml:lang="en">Total useful life of a system's battery.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Resolution">
    <rdfs:label xml:lang="en">resolution</rdfs:label>
    <skos:definition xml:lang="en">The smallest change in a quantity being measured that causes a perceptible change in the sensor output.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#UpperDetectionLimit">
    <rdfs:label xml:lang="en">upper detection limit</rdfs:label>
    <skos:definition xml:lang="en">The maximum quantity of a substance that can be reliably detected by the sensor.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#HumidityAccuracy">
    <rdfs:label xml:lang="en">humidity accuracy</rdfs:label>
    <skos:definition xml:lang="en">The closeness of agreement between the measured humidity and the true humidity.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MaxFrequency">
    <rdfs:label xml:lang="en">maximum frequency</rdfs:label>
    <skos:definition xml:lang="en">The highest frequency at which the system can operate or make observations.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MinOperatingPower">
    <rdfs:label xml:lang="en">minimum operating power</rdfs:label>
    <skos:definition xml:lang="en">The minimum power level at which the system can reliably operate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#BatteryResolution">
    <rdfs:label xml:lang="en">battery resolution</rdfs:label>
    <skos:definition xml:lang="en">The smallest detectable change in the battery level or charge state measurable by the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MinMeasurableHumidity">
    <rdfs:label xml:lang="en">minimum measurable humidity</rdfs:label>
    <skos:definition xml:lang="en">The minimum relative humidity value that the system can measure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MaintenanceSchedule">
    <rdfs:label xml:lang="en">maintenance schedule</rdfs:label>
    <skos:definition xml:lang="en">The planned interval at which the system requires inspection, calibration, or servicing.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Precision">
    <rdfs:label xml:lang="en">precision</rdfs:label>
    <skos:definition xml:lang="en">The degree to which repeated measurements show the same results.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Selectivity">
    <rdfs:label xml:lang="en">selectivity</rdfs:label>
    <skos:definition xml:lang="en">The extent to which a sensor responds only to the target measurand and not to other quantities.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#Latency">
    <rdfs:label xml:lang="en">latency</rdfs:label>
    <skos:definition xml:lang="en">The delay between the input or command and the corresponding response of a system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#ResponseTime">
    <rdfs:label xml:lang="en">response time</rdfs:label>
    <skos:definition xml:lang="en">The time it takes for a system to respond to an input or stimulus.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#TemperaturePrecision">
    <rdfs:label xml:lang="en">temperature precision</rdfs:label>
    <skos:definition xml:lang="en">The precision of the temperature measurements made by a Sensor.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#TemperatureResolution">
    <rdfs:label xml:lang="en">temperature resolution</rdfs:label>
    <skos:definition xml:lang="en">The smallest temperature change that can be detected and reported by the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MaxMeasurableTemperature">
    <rdfs:label xml:lang="en">maximum measurable temperature</rdfs:label>
    <skos:definition xml:lang="en">The maximum temperature that a Sensor can measure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MinMeasurableTemperature">
    <rdfs:label xml:lang="en">minimum measurable temperature</rdfs:label>
    <skos:definition xml:lang="en">The minimum temperature that a Sensor can measure.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-capability-properties#MaxOperatingPower">
    <rdfs:label xml:lang="en">maximum operating power</rdfs:label>
    <skos:definition xml:lang="en">The maximum power level at which the system can reliably operate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-capability-properties#"/>
  </sosa:Property>
</rdf:RDF>
