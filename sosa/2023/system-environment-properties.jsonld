    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "This vocabulary defines a short list of properties about the system environment. \n\n  It is only for illustration purposes, as the Spatio-temporal Data on the Web Working Group does not ambition to maintain a living list of properties. Extensions of this list should be led by other organization, and publications done to relevant vocabulary portals."
      }
