<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:voaf="http://purl.org/vocommons/voaf#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:sosa="http://www.w3.org/ns/sosa/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#MinAmbientRelativeHumidity">
    <rdfs:label xml:lang="en">minimum ambient humidity</rdfs:label>
    <skos:definition xml:lang="en">The minimum ambient humidity in the environment in which the system is expected to operate.</skos:definition>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <dcterms:title xml:lang="en">Sample vocabulary of properties about the system environment</dcterms:title>
        <dcterms:description xml:lang="en">This vocabulary defines a short list of properties about the system environment. 

  It is only for illustration purposes, as the Spatio-temporal Data on the Web Working Group does not ambition to maintain a living list of properties. Extensions of this list should be led by other organization, and publications done to relevant vocabulary portals.</dcterms:description>
        <dcterms:creator>
          <foaf:Agent rdf:nodeID="nb7064ccaad2443b09698115a99e0f726b1">
            <foaf:name xml:lang="en">W3C/OGC Spatio-temporal Data on the Web Working Group</foaf:name>
          </foaf:Agent>
        </dcterms:creator>
        <dcterms:rights>Copyright 2025 W3C/OGC.</dcterms:rights>
        <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
        <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
        <rdfs:comment xml:lang="en">Please report any errors to the W3C Spatio-temporal Data on the Web Working Group via the SDW WG Public List public-sdw-wg@w3.org</rdfs:comment>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-08-05</dcterms:modified>
        <vann:preferredNamespacePrefix>sosa-env</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://www.w3.org/ns/sosa/system-environment-properties#</vann:preferredNamespaceUri>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/systems/"/>
      </owl:Ontology>
    </rdfs:isDefinedBy>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#MaxAmbientRelativeHumidity">
    <rdfs:label xml:lang="en">maximum ambient humidity</rdfs:label>
    <skos:definition xml:lang="en">The maximum ambient humidity in the environment in which the system is expected to operate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#AmbientPressure">
    <rdfs:label xml:lang="en">ambient pressure</rdfs:label>
    <skos:definition xml:lang="en">The atmospheric pressure in the environment surrounding the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#MinAmbientTemperature">
    <rdfs:label xml:lang="en">minimum ambient temperature</rdfs:label>
    <skos:definition xml:lang="en">The minimum ambient temperature in the environment in which the system is expected to operate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#PollutionLevel">
    <rdfs:label xml:lang="en">pollution level</rdfs:label>
    <skos:definition xml:lang="en">The level of pollutants (e.g., particulate matter, NO₂, CO) in the air around the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#AmbientLightLevel">
    <rdfs:label xml:lang="en">ambient light level</rdfs:label>
    <skos:definition xml:lang="en">The level of illumination in the environment surrounding the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#MaxAmbientTemperature">
    <rdfs:label xml:lang="en">maximum ambient temperature</rdfs:label>
    <skos:definition xml:lang="en">The maximum ambient temperature in the environment in which the system is expected to operate.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#ExposureToVibration">
    <rdfs:label xml:lang="en">exposure to vibration</rdfs:label>
    <skos:definition xml:lang="en">Indicates whether and to what extent the system is subject to vibration in its environment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#UVExposure">
    <rdfs:label xml:lang="en">UV exposure</rdfs:label>
    <skos:definition xml:lang="en">The level of ultraviolet radiation in the system's environment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#DeploymentLocation">
    <rdfs:label xml:lang="en">deployment location</rdfs:label>
    <skos:definition xml:lang="en">The spatial location at which the system is deployed.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#WindDirection">
    <rdfs:label xml:lang="en">wind direction</rdfs:label>
    <skos:definition xml:lang="en">The direction from which the wind is blowing in the system's environment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#Altitude">
    <rdfs:label xml:lang="en">altitude</rdfs:label>
    <skos:definition xml:lang="en">The vertical distance of the system above mean sea level.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#MagneticInterferenceLevel">
    <rdfs:label xml:lang="en">magnetic interference level</rdfs:label>
    <skos:definition xml:lang="en">The level of magnetic interference present in the system's environment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#WindSpeed">
    <rdfs:label xml:lang="en">wind speed</rdfs:label>
    <skos:definition xml:lang="en">The speed of wind in the system's surrounding environment.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#AmbientTemperature">
    <rdfs:label xml:lang="en">ambient temperature</rdfs:label>
    <skos:definition xml:lang="en">The temperature of the environment of the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#DeploymentEnvironmentType">
    <rdfs:label xml:lang="en">deployment environment type</rdfs:label>
    <skos:definition xml:lang="en">The type of environment in which the system is deployed, e.g., indoor, outdoor, marine, underground.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#Salinity">
    <rdfs:label xml:lang="en">salinity</rdfs:label>
    <skos:definition xml:lang="en">The concentration of salts in the environment surrounding the system, typically used for aquatic or marine deployments.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
  <sosa:Property rdf:about="http://www.w3.org/ns/sosa/system-environment-properties#AmbientHumidity">
    <rdfs:label xml:lang="en">ambient humidity</rdfs:label>
    <skos:definition xml:lang="en">The humidity of the environment of the system.</skos:definition>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/system-environment-properties#"/>
  </sosa:Property>
</rdf:RDF>
