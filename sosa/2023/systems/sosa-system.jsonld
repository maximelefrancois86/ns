      }
    ],
    "http://schema.org/rangeIncludes": [
      {
        "@id": "http://www.w3.org/ns/sosa/ObservationCollection"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has validity context"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a an observation collection or observation (typically about the system capabilities) or a property (typically about the system capabilities) to its validity context, described as an observation collection or observation (typically about the system environment)."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/systems/",
    "@type": [
