  {
    "@id": "http://www.w3.org/ns/sosa/hasOperatingConditions",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://schema.org/domainIncludes": [
      {
        "@id": "http://www.w3.org/ns/sosa/Actuator"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/System"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Sensor"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Sampler"
      }
    ],
    "http://schema.org/rangeIncludes": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/OperatingConditions"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/ObservationCollection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has operating conditions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "\n  Relation between a System and its Operating Conditions, modelled as ObservationCollection (or Observation) describing\n  conditions under which the System can operate. A short but extensible list of sub-classes of OperatingConditions is\n  provided in SSN-System, such as normal operating conditions, suboptimal conditions, and survivable conditions.\n  "
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/SurvivableConditions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Survivable Conditions"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/OperatingConditions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "\n  Type of observation or observation collection that describe the conditions under which a system is expected to survive, that is to continue to exist in its current form,\n  even if its future operations are impaired. A typical example is the temperature at which a sensor looses physical integrity and looses its shape.\n  A system or sensor exposed to conditions outside of those reported by SurvivableConditions will no longer be serviceable.\n  "
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/SuboptimalOperatingConditions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Suboptimal Conditions"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/OperatingConditions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "\n Type of observation or observation collection that describe the conditions under which a system is expected to operate sub-optimally.\n Results will still be reported but the performance of the sensor, in term of precision for example, will be impaired.\n  "
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/NormalOperatingConditions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Normal Operating Conditions"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/OperatingConditions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "\n  Type of observation or observation collection that describe the conditions under which a system is expected to operate normally.\n  "
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/OperatingConditions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Operating Conditions"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "\n  Type of observation or observation collection that describe operating conditions of systems.\n  Sub-classes of this class explicit the desirability of the conditions.\n  Three such sub-classes are provided as a basic classification:\n  NormalOperatingConditions, SuboptimalOperatingConditions, and SurvivableConditions.\n  "
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Battery",
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Battery"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/System"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A Battery powering a System as its primary or secondary power source. As this is a specialization of the System class modeling of integrated battery management systems is also possible."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/hasSystemCapability",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://schema.org/domainIncludes": [
      {
        "@id": "http://www.w3.org/ns/sosa/Actuator"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/System"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Sensor"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Sampler"
      }
    ],
    "http://schema.org/rangeIncludes": [
      {
        "@id": "http://www.w3.org/ns/sosa/ObservationCollection"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/sosa/systems/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has system capability"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Relation between a System and an ObservationCollection (or Observation) describing the capability of the system. A sensor or system may have more than one set of system capabilities with different validity contexts."
      }
    ]
  }
]