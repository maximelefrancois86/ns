  <owl:Ontology rdf:about="http://www.w3.org/ns/ssn/act/">
    <dcterms:title xml:lang="en">Sensor, Observation, Sample, and Actuator (SOSA) Ontology - actuation module</dcterms:title>
    <dcterms:title xml:lang="en">SSN Ontology - actuation module</dcterms:title>
    <dcterms:description xml:lang="en">Actuation classes and properties for the SSN Ontology.</dcterms:description>
    <dcterms:description xml:lang="en">Actuation classes and properties for the SSN Ontology.
  This module adds RDFS and OWL axioms to the terms defined in SOSA Actuation
  </dcterms:description>
    <dcterms:creator>
      <foaf:Agent rdf:nodeID="n7e524e5e24854ac5815286c2ea2c4dccb1">
