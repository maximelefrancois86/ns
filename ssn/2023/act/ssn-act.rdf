    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-02</dcterms:created>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/act/"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/ssn/common/"/>
  </owl:Ontology>
