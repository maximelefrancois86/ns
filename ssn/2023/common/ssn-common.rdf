  <owl:Ontology rdf:about="http://www.w3.org/ns/ssn/common/">
    <dcterms:title xml:lang="en">SSN Ontology - core module</dcterms:title>
    <dcterms:description xml:lang="en">Core classes and properties for the SSN Ontology.
  This module adds RDFS and OWL axioms to the terms defined in SOSA Core
  </dcterms:description>
    <dcterms:creator>
      <foaf:Agent rdf:nodeID="ne4ef79b8cd1b47b49a4e361abcfc4923b1">
        <foaf:name xml:lang="en">W3C/OGC Spatial Data on the Web Working Group</foaf:name>
      </foaf:Agent>
    </dcterms:creator>
    <dcterms:rights>Copyright 2025 W3C/OGC.</dcterms:rights>
    <dcterms:license rdf:resource="http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"/>
    <dcterms:license rdf:resource="http://www.opengeospatial.org/ogc/Software"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-03</dcterms:created>
    <owl:imports rdf:resource="http://www.w3.org/ns/sosa/common/"/>
  </owl:Ontology>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Result">
