  <owl:Ontology rdf:about="http://www.w3.org/ns/ssn/obs/">
    <dcterms:title xml:lang="en">Sensor, Observation, Sample, and Actuator (SOSA) Ontology - actuation module</dcterms:title>
    <dcterms:description xml:lang="en">Observation classes and properties for the SSN Ontology.</dcterms:description>
