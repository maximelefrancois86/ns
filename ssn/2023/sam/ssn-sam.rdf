    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/sam/"/>
  </rdf:Description>
  <owl:Ontology rdf:about="http://www.w3.org/ns/ssn/sam/">
    <dcterms:title xml:lang="en">Sensor, Observation, Sample, and Actuator (SOSA) Ontology - actuation module</dcterms:title>
